<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-free game logic against .NET Standard 2.1 (Unity's API surface). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ColourCascade.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityAssets)/Scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
