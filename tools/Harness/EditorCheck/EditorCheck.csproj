<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-checks the Editor scripts against UnityEditor reference assemblies. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ColourCascade.Editor</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The available UnityEditor reference is 2021.1, so check the pre-2021.2 code paths. -->
    <DefineConstants>UNITY_5_3_OR_NEWER;UNITY_2017_1_OR_NEWER;UNITY_2018_1_OR_NEWER;UNITY_2019_1_OR_NEWER;UNITY_2020_1_OR_NEWER;UNITY_2021_1_OR_NEWER;ENABLE_LEGACY_INPUT_MANAGER;UNITY_EDITOR</DefineConstants>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityAssets)/Scripts/Editor/**/*.cs" />
    <Compile Include="$(UnityAssets)/Scripts/Setup/**/*.cs" />
    <ProjectReference Include="../CoreLib/CoreLib.csproj" />
    <ProjectReference Include="../ProceduralLib/ProceduralLib.csproj" />
    <ProjectReference Include="../UnityCheck/UnityCheck.csproj" />
    <Reference Include="$(UnityRefs)/engine/lib/net45/*.dll" Private="false" />
    <Reference Include="$(UnityRefs)/ugui/lib/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(UnityRefs)/editor/lib/UnityEditor.dll" Private="false" />
  </ItemGroup>
</Project>
